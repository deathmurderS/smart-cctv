generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Camera {
  id        Int      @id @default(autoincrement())
  name      String
  location  String
  status    String   @default("online")
  latitude  Float?
  longitude Float?
  streamUrl String?
  wilayah   String?
  createdAt DateTime @default(now())
  events    Event[]
}

model Event {
  id        Int      @id @default(autoincrement())
  cameraId  Int
  camera    Camera   @relation(fields: [cameraId], references: [id])
  type      String
  timestamp DateTime @default(now())
}